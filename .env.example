# Configuração do CuidaMed
# Copie este arquivo para ".env" (ou exporte as variáveis no seu ambiente)
# e preencha com as credenciais do seu projeto Supabase.

# URL do projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave pública/anon do Supabase (Settings > API > Project API keys > anon public)
SUPABASE_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE

# Define o modo de armazenamento: "supabase" usa o banco na nuvem;
# "local" (ou deixar vazio) usa o fallback em arquivo JSON local.
CUIDAMED_STORAGE=supabase
